NODE_ENV=production
PORT=5000
# SQLite file path — relative to project root, or absolute. Defaults to ./school.db.
DB_PATH=school.db
JWT_SECRET=
JWT_EXPIRES_IN=8h
JWT_ISSUER=smt-school-erp
JWT_AUDIENCE=smt-school-clients
APP_DATA_ENCRYPTION_KEY=
CLIENT_ORIGIN=
# Web push (browser notifications). Generate with: node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@smtthane.edu
