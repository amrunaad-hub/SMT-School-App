NODE_ENV=production
PORT=5000
# Postgres connection — all required except DB_SSL. Self-hosted Postgres on the
# same host/private network (e.g. the OCI VM this app runs on) typically needs
# DB_SSL=false; managed/remote Postgres usually needs DB_SSL=true.
DB_HOST=localhost
DB_PORT=5432
DB_USER=smt_school
DB_PASSWORD=
DB_NAME=smt_school
DB_SSL=false
JWT_SECRET=
JWT_EXPIRES_IN=8h
JWT_ISSUER=smt-school-erp
JWT_AUDIENCE=smt-school-clients
APP_DATA_ENCRYPTION_KEY=
CLIENT_ORIGIN=
# Web push (browser notifications). Generate with: node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@smtthane.edu
